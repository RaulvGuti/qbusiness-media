# ==========================================
# Plantilla de variables de entorno
# ==========================================
# `npm run setup` copia este archivo a DOS lugares en la raiz:
#   - .env.local -> lo lee Next.js (npm run dev, npm run build)
#   - .env       -> lo lee docker compose (build y runtime)
#
# La aplicacion Next.js y next.config.ts viven en la raiz del repositorio, que
# es el mismo lugar desde donde Docker Compose interpola sus variables.
#
# IMPORTANTE: las variables NEXT_PUBLIC_* se incrustan en el bundle del navegador
# durante el build. Cambiarlas despues NO basta: hay que recompilar
# (docker compose build --no-cache web).
#
# En produccion (Cloudflare) NO se versiona ningun archivo .env: las variables
# se cargan en el panel (Build variables y Secrets) y el codigo las lee con
# process.env. Este archivo es solo para desarrollo local y Docker.
#
# ==========================================
# Supabase Storage & Autenticación
# ==========================================
# Datos del proyecto de Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://tu-proyecto.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="tu-anon-key-publica"

# Solo servidor (src/server/supabase/admin.ts). Omite RLS: nunca la expongas
# al navegador ni le agregues el prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="tu-service-role-key-privada"

# ==========================================
# Cloudflare R2 (galería)
# ==========================================
# Credenciales SOLO del servidor. Nunca les pongas NEXT_PUBLIC_.
CLOUDFLARE_ACCOUNT_ID="mock-account-id"
R2_ACCESS_KEY_ID="mock-access-key"
R2_SECRET_ACCESS_KEY="mock-secret-key"
R2_BUCKET_NAME="qbusiness-media"

# true = no llama a R2 y devuelve URLs de ejemplo.
# Cambiar a false cuando se pongan las credenciales reales.
R2_MOCK="true"

# URL pública del bucket (custom domain de R2). Sin slash final.
# Es pública y se incrusta en el build: si cambia, hay que recompilar.
NEXT_PUBLIC_CDN_URL="https://cdn.tu-dominio.com"

# ==========================================
# Base de datos local (opcional)
# ==========================================
# Solo se usa para levantar el Postgres de docker compose o para herramientas
# de línea de comandos. La aplicación se conecta a Supabase, no a esta URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/qbusiness_media"

# ==========================================
# Contacto y Notificaciones
# ==========================================
# NO DESCOMENTAR HASTA QUE EXISTA EL MÓDULO DE NOTIFICACIONES.
# WhatsApp (enlace wa.me con el número de la empresa) y Resend (correos).
NEXT_PUBLIC_WHATSAPP_NUMBER="50259448587"
# RESEND_API_KEY="re_123456789"
NOTIFICATION_EMAIL_TO="rg4879937@gmail.com"