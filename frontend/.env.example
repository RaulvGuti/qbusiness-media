# ==========================================
# Supabase Storage & Autenticación
# ==========================================
# Datos del proyecto de Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://tu-proyecto.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="tu-anon-key-publica"

# Solo servidor (src/server/supabase/admin.ts). Omite RLS: nunca la expongas
# al navegador ni le agregues el prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="tu-service-role-key-privada"

# ==========================================
# Base de datos local (opcional)
# ==========================================
# Solo se usa para levantar el Postgres de docker compose o para herramientas
# de línea de comandos. La aplicación se conecta a Supabase, no a esta URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/qbusiness_media"

# ==========================================
# Contacto y Notificaciones
# ==========================================
# NO DESCOMENTAR HASTA QUE EXISTA EL MÓDULO DE NOTIFICACIONES.
# WhatsApp (enlace wa.me con el número de la empresa) y Resend (correos).
# NEXT_PUBLIC_WHATSAPP_NUMBER="502XXXXXXXX"
# RESEND_API_KEY="re_123456789"
# NOTIFICATION_EMAIL_TO="contacto@qbusinessmedia.com"